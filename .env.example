# =============================================================================
# CẤU HÌNH BẢO MẬT KHÓA API CHIA SẺ (SHARED API KEY)
# =============================================================================
# 1. Khóa đơn lẻ (tương thích ngược):
API_KEY=YOUR_SECRET_API_KEY

# 2. Danh sách nhiều khóa chia sẻ cho từng đối tác (phân tách bởi dấu phẩy hoặc xuống dòng):
#    Có thể gắn nhãn đối tác theo định dạng "nhan:key" để tiện kiểm soát
#    Ví dụ: openai:sk_live_openai_123,dify:sk_dify_456,cursorteam:sk_cursor_789
MCP_API_KEYS=openai:YOUR_OPENAI_SHARED_KEY,dify:YOUR_DIFY_SHARED_KEY,team:YOUR_TEAM_SHARED_KEY

# Cách gửi khóa từ Client:
# - Cách 1 (Khuyên dùng cho OpenAI Plugin / Codex): Header "Authorization: Bearer <API_KEY>"
# - Cách 2 (Khuyên dùng cho Custom GPT Actions): Header "X-API-Key: <API_KEY>"
# - Cách 3 (Dành cho SSE Client / URL query): Tham số ?key=<API_KEY> hoặc ?apiKey=<API_KEY>
# Để trống API_KEY và MCP_API_KEYS nếu muốn mở quyền truy cập công khai (chế độ phát triển).

# Port khi chạy local dev server
PORT=3000

# Base URL khi triển khai (dùng để sinh manifest OpenAI Plugin)
# MCP_BASE_URL=https://mcp-tthc.netlify.app

# Cấu hình nguồn dữ liệu TTHC (tăng tốc toàn diện qua jsDelivr Anycast CDN)
INDEX_URL=https://cdn.jsdelivr.net/gh/ChippedTopaz/am-sieu-toc-data@data/index.json
VERSION_URL=https://cdn.jsdelivr.net/gh/ChippedTopaz/am-sieu-toc-data@data/version.json
DETAILS_BASE_URL=https://cdn.jsdelivr.net/gh/ChippedTopaz/am-sieu-toc-data@data/details
