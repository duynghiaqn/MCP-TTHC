          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Danh sách và thông tin chi tiết TTHC nội bộ tỉnh Gia Lai"
          }
        }
      }
    },
    "/api/tthc/stats": {
      "get": {
        "operationId": "getStats",
        "summary": "Thống kê tổng quan cơ sở dữ liệu TTHC",
        "responses": {
          "200": {
            "description": "Thống kê tổng số bản ghi và phân bổ",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemStats"
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "security": [],
        "operationId": "getHealth",
        "summary": "Kiểm tra trạng thái hoạt động của hệ thống",
        "responses": {
          "200": {
            "description": "Thông tin hệ thống, phiên bản và dữ liệu"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Authorization: Bearer <API_KEY chia sẻ>"
      },
      "apiKeyHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "Header X-API-Key: <API_KEY chia sẻ>"
      },
      "apiKeyQuery": {
        "type": "apiKey",
        "in": "query",
        "name": "api-key",
        "description": "Tham số URL ?api-key=<API_KEY chia sẻ>"
      },
      "apiKeyQueryLegacy": {
        "type": "apiKey",
