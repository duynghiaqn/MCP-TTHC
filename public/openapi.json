            "schema": {
              "type": "string"
            },
            "description": "Cơ quan thực hiện hoặc ban hành/công bố"
          },
          {
            "name": "linh_vuc",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Lĩnh vực nghiệp vụ nội bộ"
          },
          {
            "name": "nhom_noi_bo",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "tat_ca",
                "giua_cac_co_quan",
                "trong_noi_bo"
              ]
            },
            "description": "Phân nhóm TTHC nội bộ"
          },
          {
            "name": "chi_tiet",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": false
            },
            "description": "Hiển thị chi tiết toàn bộ hồ sơ và quy trình"
          },
          {
            "name": "limit",
